styles.css

:root {
--background: #121212;
--surface: #1E1E1E;
--text: #FFFFFF;
--primary: #005FCC;
--focus: #FFD700;
}

body {
margin: 0;
font-family: Arial, sans-serif;
background: var(--background);
color: var(--text);
}

header,
nav,
footer {
padding: 20px;
}

header {
background: var(--surface);
}

nav {
background: #181818;
}

nav ul {
display: flex;
gap: 20px;
list-style: none;
}

nav a {
color: white;
text-decoration: none;
}

main {
padding: 20px;
}

form {
display: flex;
flex-direction: column;
max-width: 400px;
}

input {
margin-bottom: 15px;
padding: 10px;
}

button {
background: var(--primary);
color: white;
border: none;
padding: 12px;
cursor: pointer;
}

button:hover {
opacity: 0.9;
}

a:focus,
button:focus,
input:focus {
outline: 3px solid var(--focus);
outline-offset: 2px;
}

.skip-link {
position: absolute;
left: -9999px;
}

.skip-link:focus {
left: 10px;
top: 10px;
background: white;
color: black;
padding: 10px;
}

footer {
text-align: center;
background: var(--surface);
}

